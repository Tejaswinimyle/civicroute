# ==============================================================================
# CivicRoute Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. On your local machine, copy this file to `backend/.env` and fill in your actual keys.
# 2. In Render dashboard (Backend Web Service), add these as Environment Variables.
# 3. NEVER commit your actual `.env` file or secrets to GitHub!
# ==============================================================================

# Primary AI Vision & Reasoning Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Backup AI Reasoning Provider (NVIDIA NIM API)
NVIDIA_API_KEY=Bearer your_nvidia_api_key_here

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_generate_a_random_string

# Citizen Support Email (Optional, defaults to support@civicroute.org)
SUPPORT_EMAIL=support@civicroute.org

# Optional SMTP Settings for Live Email Delivery (Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# Frontend URL (For Production CORS, e.g. https://your-civicroute.vercel.app)
FRONTEND_URL=https://your-frontend-domain.vercel.app

